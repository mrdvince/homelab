environments:
  aion:
    values:
      - cluster: aion
        server: https://kubernetes.default.svc
        repoRevision: "HEAD"
  athos:
    values:
      - cluster: athos
        server: https://kubernetes.default.svc
        repoRevision: "HEAD"
---
bases:
  - ../../infrastructure/charts/repositories.yaml.gotmpl

releases:
  - name: appsets
    namespace: argocd
    chart: zot/upstream/argo/argocd-apps
    version: 2.0.5
    values:
      - values.yaml.gotmpl
