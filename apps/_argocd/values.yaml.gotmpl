applicationsets:
  core-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - git:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          revision: {{ .Values.repoRevision }}
          files:
            - path: apps/core/*/argocd.yaml
    template:
      metadata:
        name: '{{`{{ .path.basename }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ default .path.basename .namespace }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if hasKey . "ignoreDifferences" }}`}}
      spec:
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
      {{`{{- end }}`}}

  service-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - git:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          revision: {{ .Values.repoRevision }}
          files:
            - path: apps/services/*/argocd.yaml
    template:
      metadata:
        name: '{{`{{ .path.basename }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ default .path.basename .namespace }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
    templatePatch: |
      spec:
        {{`{{- if hasKey . "ignoreDifferences" }}`}}
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 6 }}`}}
        {{`{{- end }}`}}
        {{`{{- if and (hasKey . "serverSideApply") (not .serverSideApply) }}`}}
        syncPolicy:
          syncOptions:
            - CreateNamespace=true
        {{`{{- else }}`}}
        syncPolicy:
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
        {{`{{- end }}`}}

  storage-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - git:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          revision: {{ .Values.repoRevision }}
          files:
            - path: apps/storage/*/argocd.yaml
    template:
      metadata:
        name: '{{`{{ .path.basename }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ default .path.basename .namespace }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if hasKey . "ignoreDifferences" }}`}}
      spec:
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
      {{`{{- end }}`}}

  monitoring-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - git:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          revision: {{ .Values.repoRevision }}
          files:
            - path: apps/monitoring/*/argocd.yaml
    template:
      metadata:
        name: '{{`{{ .path.basename }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: git@gitlab.home.mrdvince.me:homelab/homelab.git
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ default .path.basename .namespace }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if hasKey . "ignoreDifferences" }}`}}
      spec:
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
      {{`{{- end }}`}}
