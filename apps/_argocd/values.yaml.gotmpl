applicationsets:
  core-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - merge:
          mergeKeys:
            - appName
          generators:
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      directories:
                        - path: apps/core/*
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
            - list:
                elements:
                  - appName: cilium
                    namespace: kube-system
                  - appName: metrics-server
                    namespace: kube-system
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      files:
                        - path: apps/core/*/argocd.yaml
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
    template:
      metadata:
        name: '{{`{{ .appName }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: {{ .Values.gitlab.repository }}
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ dig "namespace" .path.basename . }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if hasKey . "ignoreDifferences" }}`}}
      spec:
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
      {{`{{- end }}`}}

  service-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - merge:
          mergeKeys:
            - appName
          generators:
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      directories:
                        - path: apps/services/*
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      files:
                        - path: apps/services/*/argocd.yaml
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
            - list:
                elements:
                  - appName: blog
                    namespace: blog
                  - appName: codex
                    namespace: scriptorium
                  - appName: firecrawl
                    namespace: hermes
                  - appName: gitlab
                    namespace: gitlab
                  - appName: hermes
                    namespace: hermes
                  - appName: searxng
                    namespace: hermes
            - matrix:
                generators:
                  - list:
                      elements:
                        - appName: adventurelog
                        - appName: booklore
                        - appName: freshrss
                        - appName: gitlab
                        - appName: infisical
                        - appName: karakeep
                        - appName: linkwarden
                        - appName: mailrise
                        - appName: mealie
                        - appName: netbox
                        - appName: paperless
                        - appName: penpot
                        - appName: rxresume
                        - appName: scanopy
                        - appName: zot
                  - list:
                      elements:
                        - serverSideApply: "false"
    template:
      metadata:
        name: '{{`{{ .appName }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: {{ .Values.gitlab.repository }}
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ dig "namespace" "apps" . }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if or (hasKey . "ignoreDifferences") (eq (dig "serverSideApply" "true" .) "false") }}`}}
      spec:
        {{`{{- if hasKey . "ignoreDifferences" }}`}}
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
        {{`{{- end }}`}}
        {{`{{- if eq (dig "serverSideApply" "true" .) "false" }}`}}
        syncPolicy:
          syncOptions:
            - CreateNamespace=true
        {{`{{- end }}`}}
      {{`{{- end }}`}}

  storage-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - merge:
          mergeKeys:
            - appName
          generators:
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      directories:
                        - path: apps/storage/*
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
            - list:
                elements:
                  - appName: cnpg
                    namespace: cnpg-system
    template:
      metadata:
        name: '{{`{{ .appName }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: {{ .Values.gitlab.repository }}
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ dig "namespace" "kube-system" . }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if hasKey . "ignoreDifferences" }}`}}
      spec:
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
      {{`{{- end }}`}}

  monitoring-apps:
    namespace: argocd
    goTemplate: true
    generators:
      - merge:
          mergeKeys:
            - appName
          generators:
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      directories:
                        - path: apps/monitoring/*
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
            - matrix:
                generators:
                  - git:
                      repoURL: {{ .Values.gitlab.repository }}
                      revision: {{ .Values.repoRevision }}
                      files:
                        - path: apps/monitoring/*/argocd.yaml
                  - list:
                      elements:
                        - appName: '{{`{{ .path.basename }}`}}'
    template:
      metadata:
        name: '{{`{{ .appName }}`}}'
      spec:
        project: '{{`{{ dig "project" "default" . }}`}}'
        source:
          repoURL: {{ .Values.gitlab.repository }}
          targetRevision: {{ .Values.repoRevision }}
          path: '{{`{{ .path.path }}`}}'
          plugin:
            name: helmfile
            env:
              - name: ENV_NAME
                value: {{ .Values.cluster }}
        destination:
          server: {{ .Values.server }}
          namespace: '{{`{{ dig "namespace" "monitoring" . }}`}}'
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
            allowEmpty: true
          syncOptions:
            - CreateNamespace=true
            - ServerSideApply=true
    templatePatch: |
      {{`{{- if hasKey . "ignoreDifferences" }}`}}
      spec:
        ignoreDifferences: {{`{{ .ignoreDifferences | toYaml | nindent 4 }}`}}
      {{`{{- end }}`}}
