environments:
  aion:
    values:
      - ../../../infrastructure/images/config.yaml
      - ../../../infrastructure/images/images/**/*.yaml
    secrets:
      - ../../../secrets/secrets.enc.yaml
---
bases:
  - ../../../infrastructure/charts/repositories.yaml.gotmpl

releases:
  - name: argocd
    namespace: argocd
    chart: zot/upstream/argo/argo-cd
    version: 10.1.2
    values:
      - values.yaml.gotmpl
