global:
  domain: argocd.{{ .Values.domain }}
  revisionHistoryLimit: 1
{{ if not (.Values | get "renderStockImages" false) }}
  image:
    repository: {{ .Values.imageRegistry }}/argoproj/argocd
{{ end }}

server:
  extraArgs:
    - --otlp-address={{ .Values.otlpEndpoint }}
    - --otlp-insecure=true
    - --otlp-attrs=env:{{ .Environment.Name }}
  ingress:
    enabled: true
    ingressClassName: traefik
    tls: true
    extraTls:
      - secretName: wildcard-home-mrdvince-me-tls
        hosts:
          - argocd.{{ .Values.domain }}

configs:
  cm:
    url: https://argocd.{{ .Values.domain }}
    dex.config: |
      connectors:
      - config:
          issuer: https://auth.{{ .Values.domain }}/application/o/argocd/
          clientID: {{ .Values | get "argo-oidc.client_id" }}
          clientSecret: $dex.authentik.clientSecret
          insecureEnableGroups: true
          scopes:
            - openid
            - profile
            - email
        name: authentik
        type: oidc
        id: authentik
    # chart v10 defaults this to /status, which hides live status from app health here.
    resource.customizations.ignoreResourceUpdates.all: ""
  rbac:
    policy.csv: |
      g, aion-argocd-admins, role:admin
      g, aion-argocd-viewers, role:readonly
  secret:
    extra:
      dex.authentik.clientSecret: {{ .Values | get "argo-oidc.client_secret" }}
  params:
    server.insecure: true
    controller.repo.server.timeout.seconds: "180"
    server.repo.server.timeout.seconds: "180"
    controller.status.processors: "4"
    controller.operation.processors: "2"
  cmp:
    create: true
    plugins:
      helmfile:
        allowConcurrency: false
        generate:
          command:
            - bash
            - "-c"
            - |
              if [[ -v ENV_NAME ]]; then
                helmfile -e "$ENV_NAME" repos
                helmfile -e "$ENV_NAME" template --include-crds --skip-tests -q
              elif [[ -v ARGOCD_ENV_ENV_NAME ]]; then
                helmfile -e "$ARGOCD_ENV_ENV_NAME" repos
                helmfile -e "$ARGOCD_ENV_ENV_NAME" template --include-crds --skip-tests -q
              else
                helmfile repos
                helmfile template --include-crds --skip-tests -q
              fi
        lockRepo: true

controller:
  revisionHistoryLimit: 1
  extraArgs:
    - --otlp-address={{ .Values.otlpEndpoint }}
    - --otlp-insecure=true
    - --otlp-attrs=env:{{ .Environment.Name }}

repoServer:
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: "2"
      memory: 1Gi
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: node-role.kubernetes.io/control-plane
                operator: DoesNotExist
  extraArgs:
    - --parallelismlimit=2
    - --otlp-address={{ .Values.otlpEndpoint }}
    - --otlp-insecure=true
    - --otlp-attrs=env:{{ .Environment.Name }}
  livenessProbe:
    timeoutSeconds: 5
    failureThreshold: 6
  extraContainers:
    - name: helmfile
      image: {{ .Values.imageRegistry }}/helmfile/helmfile:v1.2.3
      command: ["/var/run/argocd/argocd-cmp-server"]
      env:
        - name: SOPS_AGE_KEY_FILE
          value: /app/config/age/key.txt
        - name: ARGOCD_EXEC_TIMEOUT
          value: 180s
        - name: HELM_CACHE_HOME
          value: /tmp/helm/cache
        - name: HELM_CONFIG_HOME
          value: /tmp/helm/config
        - name: HELMFILE_CACHE_HOME
          value: /tmp/helmfile/cache
        - name: HELMFILE_TEMPDIR
          value: /tmp/helmfile/tmp
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
      resources:
        requests:
          cpu: 100m
          memory: 512Mi
        limits:
          cpu: "2"
          memory: 2Gi
      volumeMounts:
        - mountPath: /var/run/argocd
          name: var-files
        - mountPath: /home/argocd/cmp-server/plugins
          name: plugins
        - mountPath: /home/argocd/cmp-server/config/plugin.yaml
          subPath: helmfile.yaml
          name: argocd-cmp-cm
        - mountPath: /tmp
          name: cmp-tmp
        - mountPath: /app/config/age/
          name: age
  volumes:
    - name: argocd-cmp-cm
      configMap:
        name: argocd-cmp-cm
    - name: cmp-tmp
      emptyDir: {}
    - name: age
      secret:
        secretName: age

{{ if not (.Values | get "renderStockImages" false) }}
dex:
  image:
    repository: {{ .Values.imageRegistry }}/dexidp/dex

redis:
  image:
    repository: {{ .Values.imageRegistry }}/docker/library/redis
{{ end }}
