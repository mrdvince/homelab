global:
  createDefaultServiceAccount: false

rawResources:
  runtime-class:
    forceRename: kata
    manifest:
      apiVersion: node.k8s.io/v1
      kind: RuntimeClass
      metadata:
        name: kata
      handler: kata
      overhead:
        podFixed:
          cpu: 250m
          memory: 130Mi
      scheduling:
        nodeSelector:
          {{ .Values.workerNodeSelectorKey }}: "true"
