{{ if not (.Values | get "renderStockImages" false) }}
image:
  registry: {{ .Values.imageRegistry }}

{{ end }}
ingressClass:
  enabled: true
  isDefaultClass: false

providers:
  kubernetesCRD:
    enabled: true
    allowCrossNamespace: true
    allowExternalNameServices: true
  kubernetesIngress:
    allowExternalNameServices: true
    allowEmptyServices: true

global:
  checkNewVersion: true

ingressRoute:
  dashboard:
    enabled: false

additionalArguments:
  - "--api.dashboard=true"
  - "--serversTransport.insecureSkipVerify=true"

ports:
  web:
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true
  websecure:
    http:
      tls:
        enabled: true
    transport:
      respondingTimeouts:
        readTimeout: 30m
        writeTimeout: 30m
  ssh:
    port: 22
    expose:
      default: true
    exposedPort: 22
    protocol: TCP
  smtps:
    port: 465
    expose:
      default: true
    exposedPort: 465
    protocol: TCP

log:
  level: INFO

accessLog:
  enabled: true

tracing:
  otlp:
    enabled: true
    grpc:
      enabled: true
      endpoint: "{{ .Values.otlpEndpoint }}"
      insecure: false
  resourceAttributes:
    env: {{ .Environment.Name }}

metrics:
  prometheus:
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true

service:
  ipFamilyPolicy: "PreferDualStack"
  type: LoadBalancer
  annotations:
    io.cilium/lb-ipam-ips: {{ .Values.traefik.loadBalancerIP }}

tolerations:
  - key: "CriticalAddonsOnly"
    operator: "Exists"

nodeSelector:
  {{ .Values.workerNodeSelectorKey }}: "true"

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: "1"
    memory: 512Mi

affinity:
  podAntiAffinity:
    requiredDuringSchedulingIgnoredDuringExecution:
      - labelSelector:
          matchLabels:
            app.kubernetes.io/name: traefik
            app.kubernetes.io/instance: traefik-traefik
        topologyKey: kubernetes.io/hostname

priorityClassName: "system-cluster-critical"

deployment:
  replicas: 2
  revisionHistoryLimit: 1
  podAnnotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9100"
    prometheus.io/path: "/metrics"

extraObjects:
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: authentik-forward-auth
      namespace: traefik
    spec:
      forwardAuth:
        address: https://forward.auth.{{ .Values.domain }}/outpost.goauthentik.io/auth/traefik
        trustForwardHeader: true
        authResponseHeaders:
          - X-authentik-username
          - X-authentik-groups
          - X-authentik-email
          - X-authentik-name
          - X-authentik-uid

  - apiVersion: cert-manager.io/v1
    kind: Certificate
    metadata:
      name: {{ .Values.tls.certificateName }}
      namespace: traefik
    spec:
      secretName: {{ .Values.tls.secretName }}
      issuerRef:
        name: letsencrypt-dns01-prod
        kind: ClusterIssuer
      dnsNames:
{{ .Values.tls.dnsNames | toYaml | nindent 8 }}
      secretTemplate:
        annotations:
          reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
          reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true"
          reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "apps,gitlab,blog,argocd,monitoring,hermes"
          reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "apps,gitlab,blog,argocd,monitoring,hermes"

  - apiVersion: traefik.io/v1alpha1
    kind: IngressRoute
    metadata:
      name: traefik-dashboard
      namespace: traefik
      annotations:
        external-dns.alpha.kubernetes.io/hostname: traefik.{{ .Values.domain }}
        external-dns.alpha.kubernetes.io/target: {{ .Values.traefik.loadBalancerIP }}
    spec:
      entryPoints:
        - websecure
      routes:
        - match: Host(`traefik.{{ .Values.domain }}`)
          kind: Rule
          services:
            - name: api@internal
              kind: TraefikService
          middlewares:
            - name: authentik-forward-auth
              namespace: traefik
      tls:
        secretName: {{ .Values.tls.secretName }}

  # gitlab ssh routing
  - apiVersion: traefik.io/v1alpha1
    kind: IngressRouteTCP
    metadata:
      name: gitlab-ssh
      namespace: traefik
    spec:
      entryPoints:
        - ssh
      routes:
        - match: HostSNI(`*`)
          services:
            - name: gitlab-gitlab-shell
              namespace: gitlab
              port: 22

  - apiVersion: traefik.io/v1alpha1
    kind: IngressRouteTCP
    metadata:
      name: mailrise-smtps
      namespace: traefik
      annotations:
        external-dns.alpha.kubernetes.io/hostname: mailrise.{{ .Values.domain }}
        external-dns.alpha.kubernetes.io/target: {{ .Values.traefik.loadBalancerIP }}
    spec:
      entryPoints:
        - smtps
      routes:
        - match: HostSNI(`mailrise.{{ .Values.domain }}`)
          services:
            - name: mailrise
              namespace: apps
              port: 8025
      tls:
        secretName: {{ .Values.tls.secretName }}
