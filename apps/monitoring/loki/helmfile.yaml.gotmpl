environments:
  aion:
    values:
      - ../../../infrastructure/images/config.yaml
      - ../../../infrastructure/images/images/**/*.yaml
    secrets:
      - ../../../secrets/secrets.enc.yaml
---
bases:
  - ../../../infrastructure/charts/repositories.yaml.gotmpl

releases:
  - name: loki
    namespace: monitoring
    chart: zot/upstream/grafana/loki
    version: 7.0.0
    values:
      - values.yaml.gotmpl
