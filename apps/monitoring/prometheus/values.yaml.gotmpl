fullnameOverride: kps

{{ if not (.Values | get "renderStockImages" false) }}
global:
  imageRegistry: {{ .Values.imageRegistry }}

{{ end }}
crds:
  enabled: true

defaultRules:
  create: true
  rules:
    alertmanager: true
    etcd: false
    configReloaders: true
    general: true
    k8sContainerCpuUsageSecondsTotal: true
    k8sContainerMemoryCache: true
    k8sContainerMemoryRss: true
    k8sContainerMemorySwap: true
    k8sContainerResource: true
    k8sContainerMemoryWorkingSetBytes: true
    k8sPodOwner: true
    kubeApiserverAvailability: true
    kubeApiserverBurnrate: true
    kubeApiserverHistogram: true
    kubeApiserverSlos: true
    kubeControllerManager: false
    kubelet: true
    kubeProxy: false
    kubePrometheusGeneral: true
    kubePrometheusNodeRecording: true
    kubernetesApps: true
    kubernetesResources: true
    kubernetesStorage: true
    kubernetesSystem: true
    kubeSchedulerAlerting: false
    kubeSchedulerRecording: false
    kubeStateMetrics: true
    network: true
    node: true
    nodeExporterAlerting: true
    nodeExporterRecording: true
    prometheus: true
    prometheusOperator: true
    windows: false

prometheusOperator:
  revisionHistoryLimit: 1

grafana:
  enabled: false
  forceDeployDashboards: true
  sidecar:
    dashboards:
      label: grafana_dashboard
      labelValue: "1"
      annotations:
        grafana_folder: Kubernetes
      multicluster:
        global:
          enabled: false
        etcd:
          enabled: false

prometheus:
  prometheusSpec:
    retention: 15d
    enableRemoteWriteReceiver: true
    # disable direct scraping - alloy handles all scraping via remote_write
    serviceMonitorSelectorNilUsesHelmValues: false
    serviceMonitorSelector:
      matchLabels:
        prometheus-scrape: disabled
    podMonitorSelectorNilUsesHelmValues: false
    podMonitorSelector:
      matchLabels:
        prometheus-scrape: disabled
    probeSelectorNilUsesHelmValues: false
    probeSelector:
      matchLabels:
        prometheus-scrape: disabled
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: truenas-iscsi
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 50Gi
    resources:
      requests:
        memory: 1Gi
        cpu: 1024m
      limits:
        memory: 4Gi
  ingress:
    enabled: true
    ingressClassName: traefik
    annotations:
      traefik.ingress.kubernetes.io/router.middlewares: traefik-authentik-forward-auth@kubernetescrd
    hosts:
      - prometheus.{{ .Values.domain }}
    tls:
      - secretName: wildcard-home-mrdvince-me-tls
        hosts:
          - prometheus.{{ .Values.domain }}

alertmanager:
  config:
    global:
      resolve_timeout: 5m
    inhibit_rules:
      - source_matchers:
          - 'severity = critical'
        target_matchers:
          - 'severity =~ warning|info'
        equal:
          - 'namespace'
          - 'alertname'
      - source_matchers:
          - 'severity = warning'
        target_matchers:
          - 'severity = info'
        equal:
          - 'namespace'
          - 'alertname'
      - source_matchers:
          - 'alertname = InfoInhibitor'
        target_matchers:
          - 'severity = info'
        equal:
          - 'namespace'
      - target_matchers:
          - 'alertname = InfoInhibitor'
    route:
      group_by: ['namespace']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h
      receiver: 'null'
      routes:
        - receiver: 'null'
          matchers:
            - alertname = "Watchdog"
        - receiver: ntfy
          matchers:
            - severity = "critical"
          group_by:
            - alertname
            - namespace
          group_wait: 30s
          group_interval: 5m
          repeat_interval: 4h
    receivers:
      - name: 'null'
      - name: ntfy
        webhook_configs:
          - url: https://ntfy.home.mrdvince.me/realm
            send_resolved: true
    templates:
      - '/etc/alertmanager/config/*.tmpl'
  ingress:
    enabled: true
    ingressClassName: traefik
    annotations:
      traefik.ingress.kubernetes.io/router.middlewares: traefik-authentik-forward-auth@kubernetescrd
    hosts:
      - alertmanager.{{ .Values.domain }}
    tls:
      - secretName: wildcard-home-mrdvince-me-tls
        hosts:
          - alertmanager.{{ .Values.domain }}

kubeControllerManager:
  enabled: false

kubeScheduler:
  enabled: false

kubeProxy:
  enabled: false

kube-state-metrics:
  revisionHistoryLimit: 1

kubeEtcd:
  enabled: false

nodeExporter:
  operatingSystems:
    linux:
      enabled: true
    aix:
      enabled: false
    darwin:
      enabled: false

prometheus-node-exporter:
  revisionHistoryLimit: 1
