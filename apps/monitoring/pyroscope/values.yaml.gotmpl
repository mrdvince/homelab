pyroscope:
{{ if not (.Values | get "renderStockImages" false) }}
  image:
    registry: {{ .Values.imageRegistry }}

{{ end }}
  persistence:
    enabled: true
    size: 20Gi
    storageClassName: truenas-iscsi

  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 1
      memory: 1Gi

  service:
    type: ClusterIP

  podAnnotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "4040"
    prometheus.io/path: "/metrics"

serviceMonitor:
  enabled: false

alloy:
  enabled: false

minio:
  enabled: false
