global:
  imageRegistry: {{ .Values.imageRegistry }}
  security:
    allowInsecureImages: true

image:
  registry: {{ .Values.imageRegistry }}
  repository: bitnamilegacy/ghost
  tag: 5.130.3-debian-12-r17

ghostUsername: zero
existingSecret: bloginfisical
ghostBlogTitle: "Nomadin"
ghostHost: blog.{{ .Values.blog.domain }}
ghostEnableHttps: true

args:
  - /bin/bash
  - -ec
  - |
      export GHOST_EMAIL="${GHOST_EMAIL_SECRET}"
      exec /opt/bitnami/scripts/ghost/run.sh

extraEnvVars:
  - name: url
    value: https://blog.{{ .Values.blog.domain }}
  - name: NODE_OPTIONS
    value: --require=/opt/bitnami/ghost-copyfile-fallback/fallback.cjs
  - name: GHOST_EMAIL_SECRET
    valueFrom:
      secretKeyRef:
        name: bloginfisical
        key: ghost-email

extraVolumes:
  - name: ghost-copyfile-fallback
    configMap:
      name: ghost-copyfile-fallback

extraVolumeMounts:
  - name: ghost-copyfile-fallback
    mountPath: /opt/bitnami/ghost-copyfile-fallback/fallback.cjs
    subPath: fallback.cjs

mysql:
  enabled: true
  image:
    registry: {{ .Values.imageRegistry }}
    repository: bitnamilegacy/mysql
    tag: 9.4.0-debian-12-r1
  auth:
    database: ghost_production
    username: ghost
    existingSecret: bloginfisical
  primary:
    persistence:
      enabled: true
      size: 10Gi
      storageClass: truenas-iscsi

persistence:
  enabled: true
  size: 20Gi
  storageClass: nfs-csi-retain

ingress:
  enabled: true
  ingressClassName: traefik
  hostname: blog.{{ .Values.blog.domain }}
  pathType: Prefix
  tls: false
  extraTls:
    - hosts:
        - blog.{{ .Values.blog.domain }}
      secretName: ghost-blog-tls
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-dns01-prod
    external-dns.alpha.kubernetes.io/hostname: blog.{{ .Values.blog.domain }}
    traefik.ingress.kubernetes.io/router.middlewares: blog-x-forwarded-proto@kubernetescrd

resources:
  limits:
    cpu: "1"
    memory: 1Gi
  requests:
    cpu: 100m
    memory: 512Mi

service:
  type: ClusterIP
  ports:
    http: 80
    https: 443
  annotations:
    traefik.ingress.kubernetes.io/service.serversscheme: http

containerPorts:
  http: 2368
  https: 2368

updateStrategy:
  type: Recreate

podSecurityContext:
  enabled: true
  fsGroup: 1001
  fsGroupChangePolicy: OnRootMismatch

extraDeploy:
  - apiVersion: v1
    kind: ConfigMap
    metadata:
      name: ghost-copyfile-fallback
      namespace: blog
    data:
      fallback.cjs: |
        const fs = require("fs");
        const nativeCopyFileSync = fs.copyFileSync;

        fs.copyFileSync = function copyFileSyncWithNfsFallback(source, destination, mode) {
          try {
            return nativeCopyFileSync.call(fs, source, destination, mode);
          } catch (error) {
            if (!error || error.code !== "EPERM") {
              throw error;
            }

            fs.writeFileSync(destination, fs.readFileSync(source));
            try {
              fs.chmodSync(destination, fs.statSync(source).mode & 0o777);
            } catch (_) {
              // Best effort: NFS can reject mode changes even after a successful write.
            }
          }
        };
  - apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      name: x-forwarded-proto
      namespace: blog
    spec:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: https
