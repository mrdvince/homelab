rawResources:
  infisical:
    forceRename: booklore
    manifest:
      apiVersion: secrets.infisical.com/v1beta1
      kind: InfisicalStaticSecret
      metadata:
        name: booklore
        namespace: apps
      spec:
        infisicalAuthRef:
          name: homelab
          namespace: infisicaloperator
        syncOptions:
          refreshInterval: 60s
        sources:
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /booklore
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /booklore/oidc
        targets:
          - name: bookloreinfisical
            namespace: apps
            kind: Secret
            creationPolicy: Owner
            template:
              engineVersion: v1
              data:
                admin-email: {{ `{{ "{{ .admin_email.Value }}" }}` | quote }}
                admin-password: {{ `{{ "{{ .admin_password.Value }}" }}` | quote }}
                admin-username: {{ `{{ "{{ .admin_username.Value }}" }}` | quote }}
                database-password: {{ `{{ "{{ .db_password.Value }}" }}` | quote }}
                database-root-password: {{ `{{ "{{ .db_root_password.Value }}" }}` | quote }}
                oidc-client-id: {{ `{{ "{{ .client_id.Value }}" }}` | quote }}
                oidc-client-secret: {{ `{{ "{{ .client_secret.Value }}" }}` | quote }}

controllers:
  main:
    revisionHistoryLimit: 1
    annotations:
      secrets.infisical.com/auto-reload: "true"
    strategy: Recreate
    containers:
      main:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.bookloreImages 0).image }}
          tag: "{{ (index .Values.bookloreImages 0).tag }}"
        command:
          - java
        args:
          - -jar
          - /app/app.jar
        env:
          TZ: {{ .Values.timezone }}
          DATABASE_URL: jdbc:mariadb://localhost:3306/booklore
          DATABASE_USERNAME: booklore
          DATABASE_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: bookloreinfisical
                key: database-password
          DISK_TYPE: LOCAL
          SWAGGER_ENABLED: "false"
          FORCE_DISABLE_OIDC: "false"
        resources:
          requests:
            cpu: 200m
            memory: 512Mi
          limits:
            cpu: "2"
            memory: 2Gi
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api/v1/healthcheck
                port: 6060
              initialDelaySeconds: 60
              periodSeconds: 30
              timeoutSeconds: 10
              failureThreshold: 3
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api/v1/healthcheck
                port: 6060
              initialDelaySeconds: 20
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 18
        securityContext:
          runAsUser: 1000
          runAsGroup: 1000
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
              - ALL
      mariadb:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.bookloreImages 1).image }}
          tag: "{{ (index .Values.bookloreImages 1).tag }}"
        env:
          MARIADB_DATABASE: booklore
          MARIADB_USER: booklore
          MARIADB_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: bookloreinfisical
                key: database-password
          MARIADB_ROOT_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: bookloreinfisical
                key: database-root-password
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: "1"
            memory: 1Gi
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              tcpSocket:
                port: 3306
              initialDelaySeconds: 10
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 12
        securityContext:
          runAsUser: 999
          runAsGroup: 1000
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  securityContext:
    runAsNonRoot: true
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch

persistence:
  database:
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    size: 10Gi
    storageClass: truenas-iscsi
    advancedMounts:
      main:
        mariadb:
          - path: /var/lib/mysql
  data:
    type: persistentVolumeClaim
    forceRename: booklore-data-iscsi
    accessMode: ReadWriteOnce
    size: 5Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        main:
          - path: /app/data
  books:
    type: persistentVolumeClaim
    forceRename: booklore-books-iscsi
    accessMode: ReadWriteOnce
    size: 100Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        main:
          - path: /books
  bookdrop:
    type: persistentVolumeClaim
    forceRename: booklore-bookdrop-iscsi
    accessMode: ReadWriteOnce
    size: 10Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        main:
          - path: /bookdrop

service:
  main:
    controller: main
    ports:
      http:
        port: 6060

ingress:
  main:
    enabled: true
    className: traefik
    hosts:
      - host: booklore.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http
    tls:
      - secretName: {{ .Values.tls.secretName }}
        hosts:
          - booklore.{{ .Values.domain }}
