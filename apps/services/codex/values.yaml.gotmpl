controllers:
  main:
    revisionHistoryLimit: 1
    strategy: Recreate
    serviceAccount:
      identifier: codex
    initContainers:
      initialize-data:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/codex
          tag: "0.146.0-3"
        command:
          - /bin/bash
        args:
          - -ec
          - |
            install -d -m 0750 -o 1000 -g 1000 \
              /mnt/data/home \
              /mnt/data/home/.cache \
              /mnt/data/home/.codex \
              /mnt/data/home/.config \
              /mnt/data/home/.local/share \
              /mnt/data/projects \
              /mnt/data/tmp
            install -d -m 0755 -o 1000 -g 1000 /mnt/data/homebrew
            install -d -m 0700 -o 1000 -g 1000 /mnt/data/home/.ssh

            if [ ! -x /mnt/data/homebrew/bin/brew ]; then
              cp -a /opt/codex/homebrew/. /mnt/data/homebrew/
              chown -R 1000:1000 /mnt/data/homebrew
            fi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: false
          runAsUser: 0
          runAsGroup: 0
          capabilities:
            drop:
              - ALL
            add:
              - CHOWN
              - DAC_OVERRIDE
              - FOWNER
    containers:
      codex:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/codex
          tag: "0.146.0-3"
        args:
          - codex-remote-control
        env:
          CODEX_INTERNAL_ORIGINATOR_OVERRIDE: Codex Desktop
          RUST_LOG: info
          TZ: Europe/Amsterdam
        resources:
          requests:
            cpu: "2"
            memory: 7Gi
          limits:
            cpu: "4"
            memory: 16Gi
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              exec:
                command:
                  - codex
                  - app-server
                  - daemon
                  - version
              initialDelaySeconds: 5
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 12
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  automountServiceAccountToken: false
  hostname: codex
  terminationGracePeriodSeconds: 60
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
                  - aion-25
                  - aion-28
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
                  - aion-25
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile:
      type: RuntimeDefault

configMaps:
  kubernetes:
    data:
      config: |
        apiVersion: v1
        kind: Config
        clusters:
          - name: aion
            cluster:
              certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
              server: https://10.30.30.145:6443
        contexts:
          - name: aion
            context:
              cluster: aion
              namespace: scriptorium
              user: codex
        current-context: aion
        users:
          - name: codex
            user:
              tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token

serviceAccount:
  codex:
    forceRename: codex

persistence:
  data:
    type: persistentVolumeClaim
    forceRename: codex
    retain: true
    accessMode: ReadWriteOnce
    size: 100Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        initialize-data:
          - path: /mnt/data
        codex:
          - path: /opt/data
          - path: /home/linuxbrew/.linuxbrew
            subPath: homebrew
          - path: /home/codex/.ssh
            subPath: home/.ssh
  kubernetes-credentials:
    type: custom
    volumeSpec:
      projected:
        defaultMode: 288
        sources:
          - serviceAccountToken:
              expirationSeconds: 3600
              path: token
          - configMap:
              name: kube-root-ca.crt
              items:
                - key: ca.crt
                  path: ca.crt
          - downwardAPI:
              items:
                - path: namespace
                  fieldRef:
                    apiVersion: v1
                    fieldPath: metadata.namespace
    advancedMounts:
      main:
        codex:
          - path: /var/run/secrets/kubernetes.io/serviceaccount
            readOnly: true
  kubernetes-config:
    type: configMap
    identifier: kubernetes
    advancedMounts:
      main:
        codex:
          - path: /etc/codex-kubernetes/config
            subPath: config
            readOnly: true
  shared-memory:
    type: emptyDir
    medium: Memory
    sizeLimit: 2Gi
    advancedMounts:
      main:
        codex:
          - path: /dev/shm
  tmp:
    type: emptyDir
    sizeLimit: 20Gi
    advancedMounts:
      main:
        codex:
          - path: /tmp

rawResources:
  kubernetes-admin-binding:
    forceRename: codex-kubernetes-admin
    manifest:
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: codex-kubernetes-admin
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: cluster-admin
      subjects:
        - kind: ServiceAccount
          name: codex
          namespace: scriptorium
  network-policy:
    forceRename: codex
    manifest:
      apiVersion: cilium.io/v2
      kind: CiliumNetworkPolicy
      metadata:
        name: codex
      specs:
        - description: isolate the namespace while preserving outbound access
          endpointSelector: {}
          ingress: []
          egress:
            - toEntities:
                - all
