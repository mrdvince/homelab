controllers:
  main:
    revisionHistoryLimit: 1
    annotations:
      secrets.infisical.com/auto-reload: "true"
    strategy: Recreate
    serviceAccount:
      identifier: codex
    initContainers:
      initialize-data:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/codex
          tag: "0.146.0-3"
        command:
          - /bin/bash
        args:
          - -ec
          - |
            install -d -m 0750 -o 1000 -g 1000 \
              /mnt/data/home \
              /mnt/data/home/.cache \
              /mnt/data/home/.codex \
              /mnt/data/home/.config \
              /mnt/data/home/.local/share \
              /mnt/data/projects \
              /mnt/data/tmp
            install -d -m 0755 -o 1000 -g 1000 /mnt/data/homebrew
            install -d -m 0755 -o 1000 -g 1000 /mnt/homebrew /mnt/codex-home

            ln -s /opt/data/homebrew /mnt/homebrew/.linuxbrew

            if [ ! -x /mnt/data/homebrew/bin/brew ]; then
              cp -a /opt/codex/homebrew/. /mnt/data/homebrew/
              chown -R 1000:1000 /mnt/data/homebrew
            fi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: false
          runAsUser: 0
          runAsGroup: 0
          capabilities:
            drop:
              - ALL
            add:
              - CHOWN
              - DAC_OVERRIDE
              - FOWNER
    containers:
      codex:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/codex
          tag: "0.146.0-3"
        args:
          - codex-remote-control
        env:
          GLAB_CONFIG_DIR: /dev/shm/glab
          GITLAB_HOST: gitlab.home.mrdvince.me
          GITLAB_TOKEN:
            valueFrom:
              secretKeyRef:
                name: codexgitlab
                key: token
          GITLAB_USERNAME:
            valueFrom:
              secretKeyRef:
                name: codexgitlab
                key: user
          GIT_CONFIG_COUNT: "7"
          GIT_CONFIG_KEY_0: url.https://oauth2@gitlab.home.mrdvince.me/.insteadOf
          GIT_CONFIG_VALUE_0: "git@gitlab.home.mrdvince.me:"
          GIT_CONFIG_KEY_1: credential.https://gitlab.home.mrdvince.me.helper
          GIT_CONFIG_VALUE_1: >-
            !f() { test "$1" = get && { echo "username=${GITLAB_USERNAME}"; echo "password=${GITLAB_TOKEN}"; }; }; f
          GIT_CONFIG_KEY_2: gpg.format
          GIT_CONFIG_VALUE_2: ssh
          GIT_CONFIG_KEY_3: gpg.ssh.defaultKeyCommand
          GIT_CONFIG_VALUE_3: ssh-add -L
          GIT_CONFIG_KEY_4: commit.gpgSign
          GIT_CONFIG_VALUE_4: "true"
          GIT_CONFIG_KEY_5: user.name
          GIT_CONFIG_VALUE_5: Vince
          GIT_CONFIG_KEY_6: user.email
          GIT_CONFIG_VALUE_6: vincivenv@gmail.com
          RUST_LOG: info
          SSH_AUTH_SOCK: /run/signing-agent/agent.sock
          TZ: Europe/Amsterdam
        resources:
          requests:
            cpu: "2"
            memory: 7Gi
          limits:
            cpu: "4"
            memory: 16Gi
        probes:
          readiness:
            enabled: true
            custom: true
            spec:
              exec:
                command:
                  - codex
                  - app-server
                  - daemon
                  - version
              initialDelaySeconds: 5
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 12
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          capabilities:
            drop:
              - ALL
      signer:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/codex
          tag: "0.146.0-3"
        command:
          - /bin/bash
        args:
          - -ec
          - |
            umask 077
            cp /run/signing-source/key /run/signing-work/key
            chmod 0600 /run/signing-work/key
            rm -f /run/signing-agent/agent.sock
            eval "$(ssh-agent -s -a /run/signing-agent/agent.sock)" >/dev/null
            ssh-add /run/signing-work/key >/dev/null
            rm -f /run/signing-work/key
            exec sleep infinity
        resources:
          requests:
            cpu: 5m
            memory: 16Mi
          limits:
            memory: 64Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 1000
          runAsGroup: 1000
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  automountServiceAccountToken: false
  hostname: codex
  runtimeClassName: kata
  terminationGracePeriodSeconds: 60
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
                  - aion-25
                  - aion-28
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          preference:
            matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
                  - aion-25
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
    seccompProfile:
      type: RuntimeDefault

configMaps:
  kubernetes:
    data:
      config: |
        apiVersion: v1
        kind: Config
        clusters:
          - name: aion
            cluster:
              certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
              server: https://10.30.30.145:6443
        contexts:
          - name: aion
            context:
              cluster: aion
              namespace: scriptorium
              user: codex
        current-context: aion
        users:
          - name: codex
            user:
              tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token

serviceAccount:
  codex:
    forceRename: codex

persistence:
  data:
    type: persistentVolumeClaim
    forceRename: codex
    retain: true
    accessMode: ReadWriteOnce
    size: 100Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        initialize-data:
          - path: /mnt/data
        codex:
          - path: /opt/data
  homebrew-link:
    type: emptyDir
    advancedMounts:
      main:
        initialize-data:
          - path: /mnt/homebrew
        codex:
          - path: /home/linuxbrew
  codex-home-link:
    type: emptyDir
    advancedMounts:
      main:
        initialize-data:
          - path: /mnt/codex-home
        codex:
          - path: /home/codex
  kubernetes-credentials:
    type: custom
    volumeSpec:
      projected:
        defaultMode: 288
        sources:
          - serviceAccountToken:
              expirationSeconds: 3600
              path: token
          - configMap:
              name: kube-root-ca.crt
              items:
                - key: ca.crt
                  path: ca.crt
          - downwardAPI:
              items:
                - path: namespace
                  fieldRef:
                    apiVersion: v1
                    fieldPath: metadata.namespace
    advancedMounts:
      main:
        codex:
          - path: /var/run/secrets/kubernetes.io/serviceaccount
            readOnly: true
  kubernetes-config:
    type: configMap
    identifier: kubernetes
    advancedMounts:
      main:
        codex:
          - path: /etc/codex-kubernetes
            readOnly: true
  shared-memory:
    type: emptyDir
    medium: Memory
    sizeLimit: 2Gi
    advancedMounts:
      main:
        codex:
          - path: /dev/shm
  signing-agent:
    type: emptyDir
    medium: Memory
    sizeLimit: 1Mi
    advancedMounts:
      main:
        codex:
          - path: /run/signing-agent
        signer:
          - path: /run/signing-agent
  signing-source:
    type: custom
    volumeSpec:
      secret:
        secretName: codexsigning
        defaultMode: 288
        items:
          - key: key
            path: key
    advancedMounts:
      main:
        signer:
          - path: /run/signing-source
            readOnly: true
  signing-work:
    type: emptyDir
    medium: Memory
    sizeLimit: 1Mi
    advancedMounts:
      main:
        signer:
          - path: /run/signing-work
  tmp:
    type: emptyDir
    sizeLimit: 20Gi
    advancedMounts:
      main:
        codex:
          - path: /tmp

rawResources:
  infisical:
    forceRename: codex
    manifest:
      apiVersion: secrets.infisical.com/v1beta1
      kind: InfisicalStaticSecret
      metadata:
        name: codex
        namespace: scriptorium
      spec:
        infisicalAuthRef:
          name: homelab
          namespace: infisicaloperator
        syncOptions:
          refreshInterval: 60s
        sources:
          - projectId: 0b29d425-2822-4168-b95f-38127a2e80d7
            environmentSlug: prod
            secretPath: /codex/gitlab
          - projectId: 0b29d425-2822-4168-b95f-38127a2e80d7
            environmentSlug: prod
            secretPath: /codex/signing
        targets:
          - name: codexgitlab
            namespace: scriptorium
            kind: Secret
            creationPolicy: Owner
            template:
              engineVersion: v1
              data:
                token: {{ `{{ "{{ .token.Value }}" }}` | quote }}
                user: {{ `{{ "{{ .user.Value }}" }}` | quote }}
          - name: codexsigning
            namespace: scriptorium
            kind: Secret
            creationPolicy: Owner
            template:
              engineVersion: v1
              data:
                key: {{ `{{ "{{ .key.Value }}" }}` | quote }}
  kubernetes-admin-binding:
    forceRename: codex-kubernetes-admin
    manifest:
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: codex-kubernetes-admin
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: cluster-admin
      subjects:
        - kind: ServiceAccount
          name: codex
          namespace: scriptorium
  network-policy:
    forceRename: codex
    manifest:
      apiVersion: cilium.io/v2
      kind: CiliumNetworkPolicy
      metadata:
        name: codex
      specs:
        - description: isolate the namespace while preserving outbound access
          endpointSelector: {}
          ingress: []
          egress:
            - toEntities:
                - all
