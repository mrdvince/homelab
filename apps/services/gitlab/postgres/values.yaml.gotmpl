fullnameOverride: gitlab-postgres
type: postgresql

version:
  postgresql: "17"

mode: standalone

cluster:
{{ if not (.Values | get "renderStockImages" false) }}
  imageName: {{ .Values.imageRegistry }}/cloudnative-pg/postgresql:18
{{ end }}
  instances: 2
  storage:
    size: 10Gi
    storageClass: truenas-iscsi-retain
  walStorage:
    enabled: true
    size: 5Gi
    storageClass: truenas-iscsi-retain

  resources:
    limits:
      cpu: "2"
      memory: 3Gi
    requests:
      cpu: 500m
      memory: 768Mi

  affinity:
    nodeSelector:
      kubernetes.io/hostname: aion-24
    tolerations:
      - key: dedicated
        operator: Equal
        value: gitlab
        effect: NoSchedule

  postgresql:
    parameters:
      max_slot_wal_keep_size: "2GB"

  initdb:
    database: gitlab
    owner: gitlab
    postInitApplicationSQL:
      - CREATE EXTENSION IF NOT EXISTS pg_trgm;
      - CREATE EXTENSION IF NOT EXISTS btree_gist;

backups:
  enabled: true
  provider: s3
  destinationPath: "s3://cnpg-backups/gitlab-postgres-after-restore"
  endpointURL: https://s3.{{ .Values.domain }}
  s3:
    region: "home"
    bucket: "cnpg-backups"
    accessKey: {{ .Values.s3.accessKey | quote }}
    secretKey: {{ .Values.s3.secretKey | quote }}
  secret:
    create: true
    name: "gitlab-postgres-s3-creds"

  wal:
    compression: gzip
    encryption: ""
    maxParallel: 1

  data:
    compression: gzip
    encryption: ""
    jobs: 1

  scheduledBackups:
    - name: daily-backup
      schedule: "0 0 0 * * *"
      backupOwnerReference: self
      method: barmanObjectStore

  retentionPolicy: "7d"
