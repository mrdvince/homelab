controllers:
  main:
    revisionHistoryLimit: 1
    annotations:
      secrets.infisical.com/auto-reload: "true"
    strategy: Recreate
    serviceAccount:
      identifier: hermes
    initContainers:
      configure-web:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.hermesImages 0).image }}
          tag: "{{ (index .Values.hermesImages 0).tag }}"
        command:
          - /opt/hermes/.venv/bin/python
        args:
          - -c
          - |
            import os
            from pathlib import Path

            import yaml

            path = Path("/opt/data/config.yaml")
            config = yaml.safe_load(path.read_text()) if path.exists() else {}
            web = config.setdefault("web", {})
            web["search_backend"] = "searxng"
            web["extract_backend"] = "firecrawl"
            temporary = path.with_suffix(".yaml.tmp")
            temporary.write_text(yaml.safe_dump(config, sort_keys=False))
            os.replace(temporary, path)
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
              - ALL
      configure-proton-bridge:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/proton-bridge
          tag: "3.25.0-1"
        command:
          - /bin/sh
        args:
          - -ec
          - |
            install -d -m 0700 "${GNUPGHOME}" "${PASSWORD_STORE_DIR}"

            key_fingerprint="$(gpg --batch --with-colons --list-secret-keys | awk -F: '$1 == "fpr" { print $10; exit }')"
            if [ -z "${key_fingerprint}" ]; then
              gpg --batch --passphrase '' --quick-generate-key "Proton Bridge <bridge@localhost.invalid>" default default never
              key_fingerprint="$(gpg --batch --with-colons --list-secret-keys | awk -F: '$1 == "fpr" { print $10; exit }')"
            fi

            if [ ! -s "${PASSWORD_STORE_DIR}/.gpg-id" ]; then
              pass init "${key_fingerprint}"
            fi
        env:
          HOME: /var/lib/proton-bridge
          GNUPGHOME: /var/lib/proton-bridge/.gnupg
          PASSWORD_STORE_DIR: /var/lib/proton-bridge/.password-store
          TMPDIR: /tmp
          XDG_CACHE_HOME: /var/lib/proton-bridge/.cache
          XDG_CONFIG_HOME: /var/lib/proton-bridge/.config
          XDG_DATA_HOME: /var/lib/proton-bridge/.local/share
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 10000
          runAsGroup: 10000
          capabilities:
            drop:
              - ALL
    containers:
      main:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/hermes-agent
          tag: "2026.7.1-2"
        args:
          - gateway
          - run
        env:
          GITLAB_HOST: gitlab.home.mrdvince.me
          GITLAB_TOKEN:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: token
          GITLAB_USERNAME:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: user
          GIT_CONFIG_COUNT: "2"
          GIT_CONFIG_KEY_0: url.https://oauth2@gitlab.home.mrdvince.me/.insteadOf
          GIT_CONFIG_VALUE_0: "git@gitlab.home.mrdvince.me:"
          GIT_CONFIG_KEY_1: credential.https://gitlab.home.mrdvince.me.helper
          GIT_CONFIG_VALUE_1: >-
            !f() { test "$1" = get && { echo "username=${GITLAB_USERNAME}"; echo "password=${GITLAB_TOKEN}"; }; }; f
          TZ: Europe/Amsterdam
          HERMES_DASHBOARD: "1"
          HERMES_DASHBOARD_HOST: 0.0.0.0
          HERMES_DASHBOARD_PORT: "9119"
          HERMES_DASHBOARD_PUBLIC_URL: https://hermes.{{ .Values.domain }}
          HERMES_DASHBOARD_OIDC_ISSUER: https://auth.{{ .Values.domain }}/application/o/hermes/
          HERMES_DASHBOARD_OIDC_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: oidc-client-id
          HERMES_DASHBOARD_OIDC_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: oidc-client-secret
          HERMES_DASHBOARD_OIDC_SCOPES: openid profile email offline_access
          HERMES_GATEWAY_BOOTSTRAP_STATE: running
          SEARXNG_URL: http://searxng:8080
          FIRECRAWL_API_URL: http://firecrawl-main:3002
          AGENT_BROWSER_ARGS: --no-sandbox
          AGENT_BROWSER_EXECUTABLE_PATH: /opt/hermes/.playwright/chromium_headless_shell-1228/chrome-headless-shell-linux64/chrome-headless-shell
          KUBECONFIG: /etc/hermes-kubernetes/config
          API_SERVER_ENABLED: "true"
          API_SERVER_HOST: 0.0.0.0
          API_SERVER_PORT: "8642"
          API_SERVER_MODEL_NAME: hermes-agent
          API_SERVER_KEY:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: api-key
          SIGNAL_HTTP_URL: http://127.0.0.1:8080
          SIGNAL_ACCOUNT:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: signal-account
        resources:
          requests:
            cpu: 250m
            memory: 1Gi
          limits:
            memory: 4Gi
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              tcpSocket:
                port: 9119
              initialDelaySeconds: 30
              periodSeconds: 30
              timeoutSeconds: 5
              failureThreshold: 3
          readiness:
            enabled: true
            custom: true
            spec:
              tcpSocket:
                port: 9119
              initialDelaySeconds: 10
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 12
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
              - ALL
            add:
              - CHOWN
              - DAC_OVERRIDE
              - FOWNER
              - SETGID
              - SETUID
      signal-cli:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/signal-cli
          tag: "0.14.5-1"
        command:
          - /bin/sh
        args:
          - -ec
          - exec signal-cli --config=/var/lib/signal-cli --account "$SIGNAL_ACCOUNT" daemon --http 127.0.0.1:8080
        env:
          HOME: /var/lib/signal-cli
          SIGNAL_ACCOUNT:
            valueFrom:
              secretKeyRef:
                name: hermesinfisical
                key: signal-account
        resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            memory: 1Gi
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              exec:
                command:
                  - /bin/bash
                  - -ec
                  - exec 3<>/dev/tcp/127.0.0.1/8080
              initialDelaySeconds: 30
              periodSeconds: 30
              timeoutSeconds: 5
              failureThreshold: 3
          readiness:
            enabled: true
            custom: true
            spec:
              exec:
                command:
                  - /bin/bash
                  - -ec
                  - exec 3<>/dev/tcp/127.0.0.1/8080
              initialDelaySeconds: 10
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 12
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 10000
          runAsGroup: 10000
          capabilities:
            drop:
              - ALL
      proton-bridge:
        image:
          repository: {{ .Values.imageRegistry }}/homelab/proton-bridge
          tag: "3.25.0-1"
        command:
          - /bin/sleep
        args:
          - infinity
        env:
          HOME: /var/lib/proton-bridge
          GNUPGHOME: /var/lib/proton-bridge/.gnupg
          PASSWORD_STORE_DIR: /var/lib/proton-bridge/.password-store
          TMPDIR: /tmp
          XDG_CACHE_HOME: /var/lib/proton-bridge/.cache
          XDG_CONFIG_HOME: /var/lib/proton-bridge/.config
          XDG_DATA_HOME: /var/lib/proton-bridge/.local/share
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            memory: 2Gi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 10000
          runAsGroup: 10000
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  automountServiceAccountToken: false
  runtimeClassName: kata
  securityContext:
    runAsNonRoot: false
    runAsUser: 0
    runAsGroup: 0
    fsGroup: 10000
    fsGroupChangePolicy: OnRootMismatch

configMaps:
  kubernetes:
    data:
      config: |
        apiVersion: v1
        kind: Config
        clusters:
          - name: aion
            cluster:
              certificate-authority: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
              server: https://10.30.30.145:6443
        contexts:
          - name: aion
            context:
              cluster: aion
              namespace: hermes
              user: hermes
        current-context: aion
        users:
          - name: hermes
            user:
              tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token

serviceAccount:
  hermes:
    forceRename: hermes

persistence:
  data:
    type: persistentVolumeClaim
    forceRename: hermes
    retain: true
    accessMode: ReadWriteOnce
    size: 50Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        main:
          - path: /opt/data
        configure-web:
          - path: /opt/data
  shared-memory:
    type: emptyDir
    medium: Memory
    sizeLimit: 1Gi
    advancedMounts:
      main:
        main:
          - path: /dev/shm
  kubernetes-credentials:
    type: custom
    volumeSpec:
      projected:
        defaultMode: 384
        sources:
          - serviceAccountToken:
              expirationSeconds: 3600
              path: token
          - configMap:
              name: kube-root-ca.crt
              items:
                - key: ca.crt
                  path: ca.crt
          - downwardAPI:
              items:
                - path: namespace
                  fieldRef:
                    apiVersion: v1
                    fieldPath: metadata.namespace
    advancedMounts:
      main:
        main:
          - path: /var/run/secrets/kubernetes.io/serviceaccount
            readOnly: true
  kubernetes-config:
    type: configMap
    identifier: kubernetes
    advancedMounts:
      main:
        main:
          - path: /etc/hermes-kubernetes
            readOnly: true
  signal-data:
    type: persistentVolumeClaim
    forceRename: hermes-signal-data
    retain: true
    accessMode: ReadWriteOnce
    size: 1Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        signal-cli:
          - path: /var/lib/signal-cli
  signal-tmp:
    type: emptyDir
    sizeLimit: 256Mi
    advancedMounts:
      main:
        signal-cli:
          - path: /tmp
  proton-bridge-data:
    type: persistentVolumeClaim
    forceRename: hermes-proton-bridge-data
    retain: true
    accessMode: ReadWriteOnce
    size: 20Gi
    storageClass: truenas-iscsi-retain
    advancedMounts:
      main:
        configure-proton-bridge:
          - path: /var/lib/proton-bridge
        proton-bridge:
          - path: /var/lib/proton-bridge
  proton-bridge-tmp:
    type: emptyDir
    sizeLimit: 256Mi
    advancedMounts:
      main:
        configure-proton-bridge:
          - path: /tmp
        proton-bridge:
          - path: /tmp

service:
  main:
    controller: main
    ports:
      dashboard:
        port: 9119
      api:
        port: 8642

ingress:
  main:
    enabled: true
    className: traefik
    hosts:
      - host: hermes.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: dashboard
    tls:
      - secretName: wildcard-home-mrdvince-me-tls
        hosts:
          - hermes.{{ .Values.domain }}

rawResources:
  infisical:
    forceRename: hermes
    manifest:
      apiVersion: secrets.infisical.com/v1beta1
      kind: InfisicalStaticSecret
      metadata:
        name: hermes
        namespace: hermes
      spec:
        infisicalAuthRef:
          name: homelab
          namespace: infisicaloperator
        syncOptions:
          refreshInterval: 60s
        sources:
          - projectId: 0b29d425-2822-4168-b95f-38127a2e80d7
            environmentSlug: prod
            secretPath: /hermes
          - projectId: 0b29d425-2822-4168-b95f-38127a2e80d7
            environmentSlug: prod
            secretPath: /hermes/oidc
          - projectId: 0b29d425-2822-4168-b95f-38127a2e80d7
            environmentSlug: prod
            secretPath: /hermes/signal
          - projectId: 0b29d425-2822-4168-b95f-38127a2e80d7
            environmentSlug: prod
            secretPath: /hermes/gitlab
        targets:
          - name: hermesinfisical
            namespace: hermes
            kind: Secret
            creationPolicy: Owner
            template:
              engineVersion: v1
              data:
                api-key: {{ `{{ "{{ .api_key.Value }}" }}` | quote }}
                oidc-client-id: {{ `{{ "{{ .client_id.Value }}" }}` | quote }}
                oidc-client-secret: {{ `{{ "{{ .client_secret.Value }}" }}` | quote }}
                signal-account: {{ `{{ "{{ .account.Value }}" }}` | quote }}
                token: {{ `{{ "{{ .token.Value }}" }}` | quote }}
                user: {{ `{{ "{{ .user.Value }}" }}` | quote }}
  kubernetes-view-binding:
    forceRename: hermes-kubernetes-view
    manifest:
      apiVersion: rbac.authorization.k8s.io/v1
      kind: ClusterRoleBinding
      metadata:
        name: hermes-kubernetes-view
      roleRef:
        apiGroup: rbac.authorization.k8s.io
        kind: ClusterRole
        name: view
      subjects:
        - kind: ServiceAccount
          name: hermes
          namespace: hermes
  network-policy:
    forceRename: hermes
    manifest:
      apiVersion: cilium.io/v2
      kind: CiliumNetworkPolicy
      metadata:
        name: hermes
      specs:
        - description: isolate the namespace while preserving its internal service graph and internet access
          endpointSelector: {}
          ingress:
            - fromEndpoints:
                - matchLabels: {}
            - fromEntities:
                - host
              toPorts:
                - ports:
                    - port: "3000"
                      protocol: TCP
                    - port: "3002"
                      protocol: TCP
                    - port: "5432"
                      protocol: TCP
                    - port: "5672"
                      protocol: TCP
                    - port: "6379"
                      protocol: TCP
                    - port: "8080"
                      protocol: TCP
                    - port: "9119"
                      protocol: TCP
          egress:
            - toEndpoints:
                - matchLabels: {}
            - toEndpoints:
                - matchLabels:
                    "k8s:io.kubernetes.pod.namespace": kube-system
                    "k8s:k8s-app": kube-dns
              toPorts:
                - ports:
                    - port: "53"
                      protocol: UDP
                    - port: "53"
                      protocol: TCP
            - toEntities:
                - world
            - toEntities:
                - kube-apiserver
              toPorts:
                - ports:
                    - port: "6443"
                      protocol: TCP

        - description: allow the dashboard through traefik and the agent API from librechat
          endpointSelector:
            matchLabels:
              app.kubernetes.io/instance: hermes
          ingress:
            - fromEndpoints:
                - matchLabels:
                    "k8s:io.kubernetes.pod.namespace": traefik
                    app.kubernetes.io/name: traefik
                    app.kubernetes.io/instance: traefik-traefik
              toPorts:
                - ports:
                    - port: "9119"
                      protocol: TCP
            - fromEndpoints:
                - matchLabels:
                    "k8s:io.kubernetes.pod.namespace": apps
                    app.kubernetes.io/instance: librechat
              toPorts:
                - ports:
                    - port: "8642"
                      protocol: TCP
