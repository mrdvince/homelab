controllers:
  main:
    revisionHistoryLimit: 1
    containers:
      main:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.infisicalImages 0).image }}
          tag: {{ (index .Values.infisicalImages 0).tag | quote }}
        envFrom:
          - secretRef:
              name: infisical
        env:
          NODE_ENV: production
          HOST: 0.0.0.0
          PORT: "8080"
          SITE_URL: https://infisical.{{ .Values.domain }}
          DB_CONNECTION_URI:
            valueFrom:
              secretKeyRef:
                name: infisical-postgres-app
                key: uri
          TELEMETRY_ENABLED: "false"
          ALLOW_INTERNAL_IP_CONNECTIONS: "true"
          TRUSTED_PROXY_CIDRS: 10.244.0.0/16
          SMTP_HOST: mailrise.apps.svc.cluster.local
          SMTP_PORT: "8025"
          SMTP_FROM_ADDRESS: infisical@{{ .Values.domain }}
          SMTP_FROM_NAME: Infisical
          SMTP_HELO_HOST: infisical.{{ .Values.domain }}
          SMTP_IGNORE_TLS: "true"
          SMTP_REQUIRE_TLS: "false"
          SMTP_USERNAME:
            valueFrom:
              secretKeyRef:
                name: mailriseinfisical
                key: smtp-username
          SMTP_PASSWORD:
            valueFrom:
              secretKeyRef:
                name: mailriseinfisical
                key: smtp-password
        resources:
          requests:
            cpu: 200m
            memory: 512Mi
          limits:
            cpu: "2"
            memory: 2Gi
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api/status
                port: 8080
              initialDelaySeconds: 60
              periodSeconds: 30
              timeoutSeconds: 5
              failureThreshold: 3
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api/status
                port: 8080
              initialDelaySeconds: 15
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 18
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch

service:
  main:
    controller: main
    ports:
      http:
        port: 8080

ingress:
  main:
    enabled: true
    className: traefik
    hosts:
      - host: infisical.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http
    tls:
      - secretName: {{ .Values.tls.secretName }}
        hosts:
          - infisical.{{ .Values.domain }}
