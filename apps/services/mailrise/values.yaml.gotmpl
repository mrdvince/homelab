controllers:
  main:
    revisionHistoryLimit: 1
    containers:
      main:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.mailriseImages 0).image }}
          tag: "{{ (index .Values.mailriseImages 0).tag }}"
        resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            cpu: 200m
            memory: 128Mi
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  securityContext:
    runAsNonRoot: true
    runAsUser: 999
    runAsGroup: 999
    fsGroup: 999

persistence:
  config:
    type: secret
    name: mailriseinfisical
    advancedMounts:
      main:
        main:
          - path: /etc/mailrise.conf
            subPath: mailrise.conf
            readOnly: true

service:
  main:
    controller: main
    type: ClusterIP
    ports:
      smtp:
        port: 8025
        protocol: TCP
