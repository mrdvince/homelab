environments:
  aion:
    values:
      - ../../../infrastructure/images/config.yaml
      - ../../../infrastructure/images/images/**/*.yaml
    secrets:
      - ../../../secrets/secrets.enc.yaml
---
repositories:
  - name: zot
    url: zot.home.mrdvince.me/helm
    oci: true
    username: {{ .Values.zot.charon_username }}
    password: {{ .Values.zot.charon_password }}

releases:
  - name: netbox-postgres
    namespace: apps
    installed: false
    chart: zot/upstream/cnpg/cluster
    version: 0.7.0
    values:
      - postgres/values.yaml.gotmpl

  - name: netbox
    namespace: apps
    installed: false
    chart: zot/upstream/netbox/netbox
    version: 8.3.30
    values:
      - netbox/values.yaml.gotmpl
    needs:
      - netbox-postgres
