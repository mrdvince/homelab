{{ if not (.Values | get "renderStockImages" false) }}
image:
  registry: {{ .Values.imageRegistry }}

{{ end }}
revisionHistoryLimit: 1

superuser:
  existingSecret: netboxinfisical

existingSecret: ""

postgresql:
  enabled: false

externalDatabase:
  host: netbox-postgres-rw
  port: 5432
  database: netbox
  username: netbox
  existingSecretName: netbox-postgres-app
  existingSecretKey: password

redis:
  enabled: false

valkey:
  enabled: true
  architecture: standalone
  auth:
    enabled: true

remoteAuth:
  enabled: true
  backends:
    - social_core.backends.open_id_connect.OpenIdConnectAuth
  autoCreateUser: true
  autoCreateGroups: true
  groupSyncEnabled: true

extraConfig:
  - secret:
      secretName: netboxinfisical
      items:
        - key: oidc.yaml
          path: oidc.yaml

persistence:
  enabled: true
  storageClass: truenas-iscsi
  size: 5Gi

reportsPersistence:
  enabled: false

ingress:
  enabled: true
  className: traefik
  hosts:
    - host: netbox.{{ .Values.domain }}
      paths:
        - /
  tls:
    - secretName: {{ .Values.tls.secretName }}
      hosts:
        - netbox.{{ .Values.domain }}

livenessProbe:
  enabled: false

customLivenessProbe:
  httpGet:
    path: /login/
    port: http
  initialDelaySeconds: 0
  periodSeconds: 10
  timeoutSeconds: 1
  failureThreshold: 3
  successThreshold: 1

resources:
  requests:
    cpu: 100m
    memory: 512Mi
  limits:
    cpu: "1"
    memory: 1Gi

housekeeping:
  enabled: true
  schedule: "0 4 * * *"

worker:
  enabled: true
  replicaCount: 1
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 512Mi
  affinity:
    podAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        - labelSelector:
            matchLabels:
              app.kubernetes.io/name: netbox
              app.kubernetes.io/component: netbox
          topologyKey: kubernetes.io/hostname
