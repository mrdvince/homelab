environments:
  aion:
    values:
      - ../../../infrastructure/images/config.yaml
      - ../../../infrastructure/images/images/**/*.yaml
    secrets:
      - ../../../secrets/secrets.enc.yaml
---
bases:
  - ../../../infrastructure/charts/repositories.yaml.gotmpl

releases:
  - name: penpot-postgres
    namespace: apps
    chart: zot/upstream/cnpg/cluster
    version: 0.7.0
    values:
      - postgres/values.yaml.gotmpl

  - name: penpot-valkey
    namespace: apps
    chart: zot/upstream/bjw-s/app-template
    version: 5.0.1
    values:
      - valkey/values.yaml.gotmpl

  - name: penpot-secrets
    namespace: apps
    chart: zot/internal/secret
    version: 0.1.0
    values:
      - fullnameOverride: penpot
        data:
          api-secret-key: {{ .Values.penpot.api_secret | trim | quote }}
          oidc-client-id: {{ .Values.penpot.oidc.client_id | trim | quote }}
          oidc-client-secret: {{ .Values.penpot.oidc.client_secret | trim | quote }}
          smtp-username: {{ .Values.mailrise.smtp_username | trim | quote }}
          smtp-password: {{ .Values.mailrise.smtp_password | trim | quote }}

  - name: penpot
    namespace: apps
    chart: zot/upstream/penpot/penpot
    version: 1.6.1
    values:
      - values.yaml.gotmpl
    needs:
      - penpot-postgres
      - penpot-valkey
      - penpot-secrets
