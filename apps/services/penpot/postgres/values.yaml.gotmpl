fullnameOverride: penpot-postgres
type: postgresql

version:
  postgresql: "17"

mode: standalone

cluster:
{{ if not (.Values | get "renderStockImages" false) }}
  imageName: {{ .Values.imageRegistry }}/cloudnative-pg/postgresql:18
{{ end }}
  instances: 1
  storage:
    size: 50Gi
    storageClass: truenas-iscsi
  walStorage:
    enabled: true
    size: 5Gi
    storageClass: truenas-iscsi

  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: "1"
      memory: 1Gi

  postgresql:
    parameters:
      max_slot_wal_keep_size: "1GB"

  initdb:
    database: penpot
    owner: penpot

backups:
  enabled: true
  provider: s3
  destinationPath: s3://cnpg-backups/penpot
  endpointURL: https://s3.{{ .Values.domain }}
  s3:
    region: home
    bucket: cnpg-backups
    accessKey: {{ .Values.s3.accessKey | quote }}
    secretKey: {{ .Values.s3.secretKey | quote }}
  secret:
    create: true
    name: penpot-postgres-s3-creds

  wal:
    compression: gzip
    encryption: ""
    maxParallel: 1

  data:
    compression: gzip
    encryption: ""
    jobs: 1

  scheduledBackups:
    - name: daily-backup
      schedule: "0 0 2 * * *"
      backupOwnerReference: self
      method: barmanObjectStore

  retentionPolicy: 7d
