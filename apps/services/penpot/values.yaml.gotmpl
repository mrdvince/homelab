fullnameOverride: penpot

config:
  publicUri: https://penpot.{{ .Values.domain }}
  flags: >-
    disable-registration
    disable-login-with-password
    disable-email-verification
    enable-login-with-oidc
    enable-oidc-registration
    enable-smtp
    enable-mcp
    enable-access-tokens
  existingSecret: penpot
  secretKeys:
    apiSecretKey: api-secret-key
  telemetryEnabled: false

  postgresql:
    host: penpot-postgres-rw.apps.svc.cluster.local
    port: 5432
    database: penpot
    existingSecret: penpot-postgres-app
    secretKeys:
      usernameKey: username
      passwordKey: password

  redis:
    host: penpot-valkey.apps.svc.cluster.local
    port: 6379
    database: "0"

  smtp:
    enabled: true
    defaultFrom: Penpot <penpot@home.mrdvince.me>
    defaultReplyTo: Penpot <penpot@home.mrdvince.me>
    host: mailrise.apps.svc.cluster.local
    port: "8025"
    tls: false
    ssl: false
    existingSecret: penpot
    secretKeys:
      usernameKey: smtp-username
      passwordKey: smtp-password

  providers:
    existingSecret: penpot
    secretKeys:
      oidcClientIDKey: oidc-client-id
      oidcClientSecretKey: oidc-client-secret
    oidc:
      enabled: true
      baseURI: https://auth.{{ .Values.domain }}/application/o/penpot/
      roles: ""
      rolesAttribute: ""
      scopes: openid profile email

backend:
{{ if not (.Values | get "renderStockImages" false) }}
  image:
    repository: {{ .Values.imageRegistry }}/{{ (index .Values.penpotImages 0).image }}
    tag: {{ (index .Values.penpotImages 0).tag | quote }}
{{ end }}
  replicaCount: 1
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      cpu: "2"
      memory: 2Gi
  extraEnvs:
    - name: PENPOT_SSRF_ALLOWED_HOSTS
      value: auth.{{ .Values.domain }}

frontend:
{{ if not (.Values | get "renderStockImages" false) }}
  image:
    repository: {{ .Values.imageRegistry }}/{{ (index .Values.penpotImages 1).image }}
    tag: {{ (index .Values.penpotImages 1).tag | quote }}
{{ end }}
  replicaCount: 1
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 512Mi
  extraEnvs:
    - name: PENPOT_OIDC_NAME
      value: Authentik

exporter:
{{ if not (.Values | get "renderStockImages" false) }}
  image:
    repository: {{ .Values.imageRegistry }}/{{ (index .Values.penpotImages 2).image }}
    tag: {{ (index .Values.penpotImages 2).tag | quote }}
{{ end }}
  replicaCount: 1
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: "1"
      memory: 1Gi

mcp:
{{ if not (.Values | get "renderStockImages" false) }}
  image:
    repository: {{ .Values.imageRegistry }}/{{ (index .Values.penpotImages 3).image }}
    tag: {{ (index .Values.penpotImages 3).tag | quote }}
{{ end }}
  replicaCount: 1
  resources:
    requests:
      cpu: 50m
      memory: 256Mi
    limits:
      cpu: "1"
      memory: 1Gi

persistence:
  assets:
    enabled: true
    storageClass: nfs-csi-retain
    size: 20Gi
    accessModes:
      - ReadWriteOnce

ingress:
  enabled: true
  className: traefik
  hosts:
    - penpot.{{ .Values.domain }}
  tls:
    - secretName: wildcard-home-mrdvince-me-tls
      hosts:
        - penpot.{{ .Values.domain }}
