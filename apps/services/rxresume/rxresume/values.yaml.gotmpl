rawResources:
  infisical:
    forceRename: rxresume
    manifest:
      apiVersion: secrets.infisical.com/v1beta1
      kind: InfisicalStaticSecret
      metadata:
        name: rxresume
        namespace: apps
      spec:
        infisicalAuthRef:
          name: homelab
          namespace: infisicaloperator
        syncOptions:
          refreshInterval: 60s
        sources:
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /rxresume
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /rxresume/oidc
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /s3
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /mailrise
        targets:
          - name: rxresumeinfisical
            namespace: apps
            kind: Secret
            creationPolicy: Owner
            template:
              engineVersion: v1
              data:
                auth-secret: {{ `{{ "{{ .auth_secret.Value }}" }}` | quote }}
                client-id: {{ `{{ "{{ .client_id.Value }}" }}` | quote }}
                client-secret: {{ `{{ "{{ .client_secret.Value }}" }}` | quote }}
                s3-access-key: {{ `{{ "{{ .accessKey.Value }}" }}` | quote }}
                s3-secret-key: {{ `{{ "{{ .secretKey.Value }}" }}` | quote }}
                smtp-password: {{ `{{ "{{ .smtp_password.Value }}" }}` | quote }}
                smtp-username: {{ `{{ "{{ .smtp_username.Value }}" }}` | quote }}

controllers:
  main:
    revisionHistoryLimit: 1
    annotations:
      secrets.infisical.com/auto-reload: "true"
    containers:
      main:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.rxresumeImages 0).image }}
          tag: "{{ (index .Values.rxresumeImages 0).tag }}"
        env:
          TZ: {{ .Values.timezone }}
          APP_URL: https://resume.{{ .Values.domain }}
          DATABASE_URL:
            valueFrom:
              secretKeyRef:
                name: rxresume-postgres-app
                key: uri
          AUTH_SECRET:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: auth-secret
          OAUTH_PROVIDER_NAME: Authentik
          OAUTH_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: client-id
          OAUTH_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: client-secret
          OAUTH_DISCOVERY_URL: https://auth.{{ .Values.domain }}/application/o/rxresume/.well-known/openid-configuration
          OAUTH_SCOPES: openid profile email
          S3_ACCESS_KEY_ID:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: s3-access-key
          S3_SECRET_ACCESS_KEY:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: s3-secret-key
          S3_REGION: home
          S3_ENDPOINT: https://s3.{{ .Values.domain }}
          S3_BUCKET: reactive-resume
          S3_FORCE_PATH_STYLE: "true"
          SMTP_HOST: mailrise.apps.svc.cluster.local
          SMTP_PORT: "8025"
          SMTP_USER:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: smtp-username
          SMTP_PASS:
            valueFrom:
              secretKeyRef:
                name: rxresumeinfisical
                key: smtp-password
          SMTP_FROM: Reactive Resume <reactive-resume@{{ .Values.domain }}>
          SMTP_SECURE: "false"
          FLAG_SHOW_SPONSORS: "false"
        resources:
          requests:
            cpu: 100m
            memory: 512Mi
          limits:
            cpu: "1"
            memory: 1Gi
        probes:
          liveness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api/health
                port: 3000
              initialDelaySeconds: 30
              periodSeconds: 30
              timeoutSeconds: 10
              failureThreshold: 3
          readiness:
            enabled: true
            custom: true
            spec:
              httpGet:
                path: /api/health
                port: 3000
              initialDelaySeconds: 10
              periodSeconds: 10
              timeoutSeconds: 5
              failureThreshold: 6
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: false
          capabilities:
            drop:
              - ALL

defaultPodOptions:
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000

persistence:
  data:
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    size: 5Gi
    storageClass: nfs-csi-retain
    globalMounts:
      - path: /app/data

service:
  main:
    controller: main
    ports:
      http:
        port: 3000

ingress:
  main:
    enabled: true
    className: traefik
    hosts:
      - host: resume.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http
    tls:
      - secretName: {{ .Values.tls.secretName }}
        hosts:
          - resume.{{ .Values.domain }}
