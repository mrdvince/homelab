rawResources:
  infisical:
    forceRename: scanopy
    manifest:
      apiVersion: secrets.infisical.com/v1beta1
      kind: InfisicalStaticSecret
      metadata:
        name: scanopy
        namespace: apps
      spec:
        infisicalAuthRef:
          name: homelab
          namespace: infisicaloperator
        syncOptions:
          refreshInterval: 60s
        sources:
          - projectId: {{ .Values.infisical.projectId }}
            environmentSlug: prod
            secretPath: /scanopy-oidc
        targets:
          - name: scanopyinfisical
            namespace: apps
            kind: Secret
            creationPolicy: Owner
            template:
              engineVersion: v1
              data:
                client-id: {{ `{{ "{{ .client_id.Value }}" }}` | quote }}
                client-secret: {{ `{{ "{{ .client_secret.Value }}" }}` | quote }}

controllers:
  main:
    revisionHistoryLimit: 1
    annotations:
      secrets.infisical.com/auto-reload: "true"
    containers:
      main:
        image:
          repository: {{ .Values.imageRegistry }}/{{ (index .Values.scanopy 0).image }}
          tag: "{{ (index .Values.scanopy 0).tag }}"
        env:
          SCANOPY_LOG_LEVEL: info
          SCANOPY_SERVER_PORT: "60072"
          SCANOPY_PUBLIC_URL: https://scanopy.{{ .Values.domain }}
          SCANOPY_WEB_EXTERNAL_PATH: /app/static
          SCANOPY_DATABASE_URL:
            valueFrom:
              secretKeyRef:
                name: scanopy-postgres-app
                key: uri
          OIDC_CLIENT_ID:
            valueFrom:
              secretKeyRef:
                name: scanopyinfisical
                key: client-id
          OIDC_CLIENT_SECRET:
            valueFrom:
              secretKeyRef:
                name: scanopyinfisical
                key: client-secret
          SCANOPY_OIDC_PROVIDERS: '[{name="Authentik",slug="authentik",issuer_url="https://auth.{{ .Values.domain }}/application/o/scanopy/",client_id="$(OIDC_CLIENT_ID)",client_secret="$(OIDC_CLIENT_SECRET)"}]'
        resources:
          requests:
            cpu: 100m
            memory: 256Mi
          limits:
            cpu: "1"
            memory: 1Gi

persistence:
  data:
    type: persistentVolumeClaim
    accessMode: ReadWriteOnce
    size: 10Gi
    storageClass: nfs-csi-retain
    advancedMounts:
      main:
        main:
          - path: /data

service:
  main:
    controller: main
    ports:
      http:
        port: 60072

ingress:
  main:
    enabled: true
    className: traefik
    hosts:
      - host: scanopy.{{ .Values.domain }}
        paths:
          - path: /
            pathType: Prefix
            service:
              identifier: main
              port: http
    tls:
      - secretName: {{ .Values.tls.secretName }}
        hosts:
          - scanopy.{{ .Values.domain }}
