environments:
  aion:
    values:
      - ../../../infrastructure/images/config.yaml
      - ../../../infrastructure/images/images/**/*.yaml
      - enableBarmanPluginCanary: false
---
bases:
  - ../../../infrastructure/charts/repositories.yaml.gotmpl

releases:
  - name: cnpg
    namespace: cnpg-system
    chart: zot/upstream/cnpg/cloudnative-pg
    version: 0.29.0
    values:
      - values.yaml.gotmpl

  - name: plugin-barman-cloud
    namespace: cnpg-system
    chart: zot/upstream/cnpg/plugin-barman-cloud
    version: 0.7.0
    needs:
      - cnpg-system/cnpg
    values:
      - plugin-values.yaml.gotmpl

  - name: test-cluster
    namespace: cnpg-system
    chart: ./test-cluster
    installed: {{ .Values.enableBarmanPluginCanary }}
    needs:
      - cnpg-system/plugin-barman-cloud
    values:
      - test-cluster/values.yaml.gotmpl
