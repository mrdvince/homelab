namespace: cnpg-test

cluster:
  name: test-cluster
{{ if not (.Values | get "renderStockImages" false) }}
  imageName: {{ .Values.imageRegistry }}/cloudnative-pg/postgresql:18
{{ else }}
  imageName: ghcr.io/cloudnative-pg/postgresql:18
{{ end }}
  instances: 3
  storage:
    size: 5Gi
    storageClass: longhorn
  walStorage:
    size: 1Gi
    storageClass: longhorn
  resources:
    limits:
      cpu: 500m
      memory: 512Mi
    requests:
      cpu: 100m
      memory: 256Mi
  postgresql:
    parameters:
      max_slot_wal_keep_size: 1GB
  initdb:
    database: testdb
    owner: testuser

objectStore:
  name: test-cluster-backups
  endpointURL: https://s3.home.mrdvince.me
  destinationPath: s3://cnpg-backups/test-cluster-plugin
  retentionPolicy: 7d
  instanceSidecarEnv:
    - name: AWS_DEFAULT_REGION
      value: home
    - name: AWS_REQUEST_CHECKSUM_CALCULATION
      value: when_required
    - name: AWS_RESPONSE_CHECKSUM_VALIDATION
      value: when_required
  wal:
    compression: gzip
    maxParallel: 1
  data:
    compression: gzip
    jobs: 1

credentials:
  name: test-cluster-s3-creds
  accessKey: {{ .Values.s3.accessKey | quote }}
  secretKey: {{ .Values.s3.secretKey | quote }}

scheduledBackup:
  name: daily-backup
  schedule: "0 0 0 * * *"
