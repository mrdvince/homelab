environments:
  aion:
    values:
      - ../../../infrastructure/images/config.yaml
      - ../../../infrastructure/images/images/**/*.yaml
      - truenas:
          democratic_csi:
            iscsi:
              dataset_parent: swamp/moss/aion-iscsi
              detached_snapshots_dataset_parent: swamp/moss/aion-iscsi-snaps
              portal_group: 1
              initiator_group: 2
    secrets:
      - ../../../secrets/secrets.enc.yaml
---
repositories:
  - name: zot
    url: zot.home.mrdvince.me/helm
    oci: true
    username: {{ .Values.zot.charon_username }}
    password: {{ .Values.zot.charon_password }}

releases:
  - name: democratic-csi-iscsi
    namespace: kube-system
    chart: zot/upstream/democratic-csi/democratic-csi
    version: 0.15.1
    values:
      - values.yaml.gotmpl
