externalSnapshotter:
  enabled: true

{{ if not (.Values | get "renderStockImages" false) }}
image:
  baseRepo: {{ .Values.imageRegistry }}
  nfs:
    repository: {{ .Values.imageRegistry }}/sig-storage/nfsplugin

{{ end }}
controller:
  runOnControlPlane: true
  replicas: 2

storageClasses:
  - name: nfs-csi
    parameters:
      server: {{ .Values.nfs_server }}
      share: {{ .Values.nfs.share }}
    reclaimPolicy: Delete
    volumeBindingMode: Immediate
    mountOptions:
      - nfsvers=4.1
  - name: nfs-csi-retain
    parameters:
      server: {{ .Values.nfs_server }}
      share: {{ .Values.nfs.share }}
    reclaimPolicy: Retain
    volumeBindingMode: Immediate
    mountOptions:
      - nfsvers=4.1
