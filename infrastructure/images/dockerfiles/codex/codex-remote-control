#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC2317
stop_remote_control() {
  codex remote-control stop >/dev/null 2>&1 || true
}

trap stop_remote_control EXIT INT TERM

until codex login status >/dev/null 2>&1; do
  echo "waiting for codex authentication"
  sleep 10
done

install -d -m 0750 "$CODEX_HOME/packages/standalone/current"
ln -sfn "$(command -v codex)" "$CODEX_HOME/packages/standalone/current/codex"
rm -rf "$CODEX_HOME/app-server-daemon"

codex remote-control start

while codex app-server daemon version >/dev/null 2>&1; do
  sleep 15
done

echo "codex app-server daemon stopped unexpectedly" >&2
exit 1
