{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prBodyTemplate": "{{{table}}}{{{changelogs}}}{{{controls}}}",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infrastructure/images/images/.*\\.yaml$/"
      ],
      "matchStrings": [
        "registry:\\s*(?<registry>[^\\n]+)\\n\\s*image:\\s*(?<depName>[^\\n]+)\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\n]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{registry}}/{{depName}}"
    }
  ],
  "ignoreDeps": [
    "registry.home.mrdvince.me/homelab/builder",
    "secret",
    "clusterissuer",
    "cilium-config",
    "actual",
    "bar-assistant"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "infrastructure/images/images/**"
      ],
      "groupName": "container images"
    },
    {
      "matchManagers": [
        "helmfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "helm charts (minor/patch)"
    },
    {
      "groupName": "gitlab stack",
      "matchPackageNames": [
        "/^gitlab-org//"
      ]
    },
    {
      "groupName": "monitoring stack",
      "matchPackageNames": [
        "/^grafana//",
        "/^prometheus/",
        "/kube-prometheus-stack/"
      ]
    },
    {
      "matchManagers": ["helmfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "keep cilium updates isolated from bulk chart/image bumps",
      "matchManagers": [
        "helmfile",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/(^|\\/)cilium($|[-/])/"
      ],
      "groupName": "cilium stack",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": [
        "critical-infra"
      ]
    },
    {
      "description": "keep longhorn updates isolated from bulk chart/image bumps",
      "matchManagers": [
        "helmfile",
        "custom.regex"
      ],
      "matchPackageNames": [
        "/longhorn/"
      ],
      "groupName": "longhorn stack",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": [
        "critical-infra"
      ]
    },
    {
      "matchManagers": [
        "helmfile"
      ],
      "matchPackageNames": [
        "bitnami/ghost"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["quay.io/kiwigrid/k8s-sidecar"],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": ["major-update"],
      "dependencyDashboardApproval": true
    }
  ]
}
