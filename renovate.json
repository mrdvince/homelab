{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "prBodyTemplate": "{{{table}}}{{{changelogs}}}{{{controls}}}",
  "dependencyDashboard": true,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "dependencyDashboardApproval": false,
    "prCreation": "immediate"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^infrastructure/images/images/.*\\.yaml$/"],
      "matchStrings": [
        "registry:\\s*(?<registry>[^\\n]+)\\n\\s*image:\\s*(?<depName>[^\\n]+)\\n\\s*tag:\\s*[\"']?(?<currentValue>[^\"'\\n]+)[\"']?"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{registry}}/{{depName}}"
    }
  ],
  "ignoreDeps": [
    "registry.home.mrdvince.me/homelab/builder",
    "registry.home.mrdvince.me/renovate/renovate",
    "secret",
    "clusterissuer",
    "cilium-config",
    "actual",
    "bar-assistant"
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["infrastructure/images/images/**"],
      "groupName": "container images"
    },
    {
      "matchManagers": ["helmfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "helm charts (minor/patch)"
    },
    {
      "groupName": "gitlab stack",
      "matchPackageNames": ["/^gitlab-org//"]
    },
    {
      "groupName": "monitoring stack",
      "matchPackageNames": [
        "/^grafana//",
        "/^prometheus/",
        "/kube-prometheus-stack/"
      ]
    },
    {
      "matchManagers": ["helmfile"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "keep cilium updates isolated from bulk chart/image bumps",
      "matchManagers": ["helmfile", "custom.regex"],
      "matchPackageNames": ["/(^|\\/)cilium($|[-/])/"],
      "groupName": "cilium stack",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": ["critical-infra"]
    },
    {
      "description": "keep longhorn updates isolated from bulk chart/image bumps",
      "matchManagers": ["helmfile", "custom.regex"],
      "matchPackageNames": ["/longhorn/"],
      "groupName": "longhorn stack",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "addLabels": ["critical-infra"]
    },
    {
      "description": "ignore ghost app chart and bundled bitnami legacy images",
      "matchPackageNames": [
        "ghost",
        "bitnami/ghost",
        "docker.io/bitnamilegacy/ghost",
        "docker.io/bitnamilegacy/mysql",
        "docker.io/bitnamilegacy/redis",
        "docker.io/bitnamilegacy/redis-exporter"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": ["quay.io/kiwigrid/k8s-sidecar"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"],
      "dependencyDashboardApproval": true
    }
  ]
}
